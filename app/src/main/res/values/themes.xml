<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompat-based so that AppCompat/MediaRouter dialogs (the Cast device picker) can resolve
        colorPrimary and friends; platform Theme.Material leaves them unset, which crashes the
        picker with "background can not be translucent". The UI itself is drawn by Compose.
    -->
    <style name="Theme.Mosaic" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mosaic.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_on_dark</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@color/brand_primary_on_dark</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
